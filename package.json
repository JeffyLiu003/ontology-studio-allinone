{
  "name": "ontology-studio-allinone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local evidence-first seven-model ontology studio",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "start:background": "node script/service.mjs start",
    "stop": "node script/service.mjs stop",
    "restart": "node script/service.mjs restart",
    "status": "node script/service.mjs status"
  },
  "engines": {
    "node": ">=24"
  }
}
